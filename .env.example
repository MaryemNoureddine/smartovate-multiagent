# Copier ce fichier en .env puis renseigner les valeurs. Ne JAMAIS versionner .env.

# --- Application ---
# dev | test | production
APP_ENV=dev
# clé exigée dans l'en-tête X-API-Key (obligatoirement changée en production)
API_KEY=change-me-dev-key
LOG_LEVEL=INFO
MAX_CONCURRENT_TASKS=2

# --- LLM ---
# auto (Azure si credentials, sinon simulation) | azure | mock
LLM_MODE=auto
# https://<ressource>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_MODEL=gpt-4o
AZURE_OPENAI_MODEL_VERSION=2024-11-20
TEMPERATURE=0.2
MAX_TOKENS_PER_CALL=1500
CONTEXT_TOKEN_LIMIT=8000

# --- Orchestration ---
# selector | sequential | nested
TEAM_PATTERN=selector
MAX_MESSAGES=15
MAX_REVIEW_ROUNDS=3
MAX_TOTAL_TOKENS=60000
TASK_TIMEOUT_SECONDS=300
HUMAN_IN_THE_LOOP=false
HUMAN_TIMEOUT_SECONDS=600

# --- Exécution de code (Bug 3) ---
# sandbox | docker | aca | disabled
CODE_EXECUTOR=sandbox
CODE_TIMEOUT_SECONDS=30
DOCKER_IMAGE=python:3.12-slim
# https://<region>.dynamicsessions.io/subscriptions/.../sessionPools/<pool>
ACA_POOL_MANAGEMENT_ENDPOINT=

# --- Mémoire ---
# rediss://:<clé>@<nom>.<region>.redis.azure.net:10000
REDIS_URL=
REDIS_TTL_SECONDS=86400
# https://<compte>.documents.azure.com:443/
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=smartovate_mas
COSMOS_CONTAINER=conversations
REDACT_PII_IN_AUDIT=true

# --- Observabilité ---
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- UI ---
API_BASE_URL=http://localhost:8000
